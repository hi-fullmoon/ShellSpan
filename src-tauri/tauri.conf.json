{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShellSpan",
  "version": "3.0.0-beta.4",
  "identifier": "com.shellspan",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm native:prepare && pnpm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ShellSpan",
        "width": 1480,
        "height": 920,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://api.iconify.design; media-src 'self' data: blob:; object-src 'self' data: blob:; frame-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://github.com https://api.iconify.design; font-src 'self' data:"
    }
  },
  "bundle": {
    "resources": {
      "resources/native-input/README.md": "native-input/README.md",
      "target/native-input/generated/": "native-input/generated/"
    },
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "macOS": {
      "signingIdentity": "ShellSpan Dev",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/shellspan.desktop.hbs"
      },
      "rpm": {
        "desktopTemplate": "linux/shellspan.desktop.hbs"
      }
    },
    "windows": {
      "minimumWebview2Version": "133.0.0.0",
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/hi-fullmoon/ShellSpan/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzNTc1OUI0MjA2OTRGMUIKUldRYlQya2d0RmxYOC9yQnk3dmxnZGc1YWlOaUQzaW9wb1BTbytvWVpYaGwrZkZuekgwdm5Bb3YK"
    }
  }
}
