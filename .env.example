# Copy this file to `.env.local` for local release configuration.

TAURI_SIGNING_PRIVATE_KEY_PASSWORD=your-updater-key-password

# Terminal Agent phased rollout.
# Agent rollout: disabled | internal | preview | stable. Omit for Stable.
SHELLSPAN_AGENT_ROLLOUT=stable
# Legacy compatibility: true/1 maps to internal; an explicit false maps to disabled.
# SHELLSPAN_EXPERIMENTAL_AGENT=false

# Optional live provider smoke tests. Keep real values in `.env.local`, which is gitignored.
# SHELLSPAN_LIVE_MINIMAX_API_KEY=your-minimax-api-key
# SHELLSPAN_LIVE_MINIMAX_BASE_URL=https://api.minimaxi.com
# SHELLSPAN_LIVE_MINIMAX_MODEL=MiniMax-M2.7
# SHELLSPAN_LIVE_DEEPSEEK_API_KEY=your-deepseek-api-key
# SHELLSPAN_LIVE_DEEPSEEK_BASE_URL=https://api.deepseek.com
# SHELLSPAN_LIVE_DEEPSEEK_MODEL=deepseek-reasoner
# SHELLSPAN_LIVE_COMPATIBLE_BASE_URL=https://provider.example/v1
# SHELLSPAN_LIVE_COMPATIBLE_MODEL=your-compatible-model
# SHELLSPAN_LIVE_COMPATIBLE_API_KEY=optional-compatible-api-key
