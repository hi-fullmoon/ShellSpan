{
  "schemaVersion": 2,
  "kind": "deployment",
  "id": "acme-api-production",
  "name": "Deploy Acme API to production",
  "description": "Install a verified release, atomically activate it, restart the service, and verify health.",
  "deployment": {
    "id": "acme-api-2.4.0-20260828",
    "applicationId": "acme-api",
    "environment": "production",
    "version": "2.4.0"
  },
  "artifacts": [
    {
      "id": "application-bundle",
      "description": "Public Acme API release archive.",
      "kind": "archive",
      "sourceUri": "https://artifacts.example.com/acme-api/2.4.0/acme-api.tar.gz",
      "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "targetPath": "artifacts/acme-api.tar.gz",
      "sizeBytes": 1048576,
      "unpack": {
        "format": "tarGz",
        "destinationPath": ".",
        "stripComponents": 1
      }
    }
  ],
  "release": {
    "rootDirectory": "/srv/acme-api",
    "releasesDirectory": "/srv/acme-api/releases",
    "releaseDirectory": "/srv/acme-api/releases/acme-api-2.4.0-20260828",
    "activeSymlink": "/srv/acme-api/current",
    "activationStrategy": "atomicSymlinkSwap"
  },
  "services": [
    {
      "id": "api",
      "manager": "systemd",
      "unit": "acme-api.service"
    }
  ],
  "serviceActions": [
    {
      "id": "restart-api",
      "serviceId": "api",
      "action": "restart",
      "risk": "stateChange",
      "timeoutSeconds": 60
    }
  ],
  "verification": {
    "checks": [
      {
        "id": "api-service-active",
        "kind": "service",
        "serviceId": "api",
        "expectedState": "active",
        "timeoutSeconds": 10,
        "attempts": 3,
        "intervalSeconds": 2
      },
      {
        "id": "api-http-health",
        "kind": "http",
        "url": "http://127.0.0.1:8080/health",
        "expectedStatus": 200,
        "timeoutSeconds": 5,
        "attempts": 12,
        "intervalSeconds": 5
      }
    ]
  },
  "rollback": {
    "strategy": "reactivatePreviousRelease",
    "serviceActions": [
      {
        "id": "rollback-restart-api",
        "serviceId": "api",
        "action": "restart",
        "risk": "stateChange",
        "timeoutSeconds": 60
      }
    ],
    "verificationCheckIds": [
      "api-service-active",
      "api-http-health"
    ]
  },
  "security": {
    "declaredRisk": "stateChange",
    "allowPrivilegeEscalation": false,
    "approval": {
      "deployment": "explicit",
      "rollback": "separate",
      "destructive": "doubleConfirmation",
      "targetBinding": "frozenProfile"
    },
    "secretRefs": []
  }
}
