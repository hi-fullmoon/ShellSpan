+        .filter(|event| match &event.payload {
+            AgentSessionEventPayload::ToolCall { call } => {
+                call.native_name.is_some()
+                    || !skipped.contains(&(event.step_id.as_deref(), call.call_id.as_str()))
+            }
+            _ => false,
+        })
