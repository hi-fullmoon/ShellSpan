+    struct CancelHook {
+        registry: Mutex<Option<AgentRegistry>>,
+        before: bool,
+    }
+
+    impl AgentBeforeToolHook for CancelHook {
+        fn before_tool(
+            &self,
+            context: &AgentBeforeToolContext,
+        ) -> Result<AgentBeforeToolDecision, String> {
+            if self.before {
+                self.registry
+                    .lock()
+                    .unwrap()
+                    .as_ref()
