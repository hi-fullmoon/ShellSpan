+fn ensure_not_cancelled(cancellation: &CancellationToken) -> Result<(), String> {
+    if cancellation.is_cancelled() {
+        Err("compaction cancelled before committing a checkpoint".into())
+    } else {
+        Ok(())
+    }
+}
