{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://termbridge.app/protocol/agent/v1/agent-decision.schema.json",
  "title": "TermBridge AgentDecisionV1",
  "description": "Exactly one provider-neutral P1 read-only Agent decision.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "rationale",
        "plan",
        "tool",
        "arguments",
        "purpose",
        "successCriteria"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "toolCall" },
        "rationale": { "$ref": "#/$defs/rationale" },
        "plan": { "$ref": "#/$defs/plan" },
        "tool": { "const": "host.inspect" },
        "arguments": { "$ref": "#/$defs/hostInspectArguments" },
        "purpose": { "$ref": "#/$defs/purpose" },
        "successCriteria": { "$ref": "#/$defs/successCriteria" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "rationale",
        "plan",
        "tool",
        "arguments",
        "purpose",
        "successCriteria"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "toolCall" },
        "rationale": { "$ref": "#/$defs/rationale" },
        "plan": { "$ref": "#/$defs/plan" },
        "tool": { "const": "shell.execReadOnly" },
        "arguments": { "$ref": "#/$defs/shellExecReadOnlyArguments" },
        "purpose": { "$ref": "#/$defs/purpose" },
        "successCriteria": { "$ref": "#/$defs/successCriteria" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "rationale", "plan", "question"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "askUser" },
        "rationale": { "$ref": "#/$defs/rationale" },
        "plan": { "$ref": "#/$defs/plan" },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "rationale", "plan", "report"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "final" },
        "rationale": { "$ref": "#/$defs/rationale" },
        "plan": { "$ref": "#/$defs/plan" },
        "report": { "$ref": "#/$defs/finalReport" }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "successCriteria": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/planItem" }
        }
      }
    },
    "planItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "status": {
          "enum": ["pending", "active", "completed", "skipped"]
        }
      }
    },
    "hostInspectArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "os",
              "kernel",
              "architecture",
              "identity",
              "uptime",
              "capabilities"
            ]
          }
        }
      }
    },
    "shellExecReadOnlyArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program", "args"],
      "properties": {
        "program": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "args": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "finalReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "summary", "findings", "changes", "warnings", "nextActions"],
      "properties": {
        "outcome": {
          "enum": ["resolved", "diagnosed", "inconclusive", "blocked"]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "findings": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/finding" }
        },
        "changes": {
          "type": "array",
          "maxItems": 0
        },
        "warnings": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        },
        "nextActions": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/nextAction" }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "detail", "confidence", "evidenceIds"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "confidence": {
          "enum": ["verified", "likely", "uncertain"]
        },
        "evidenceIds": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/identifier" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "confidence": { "const": "verified" } },
            "required": ["confidence"]
          },
          "then": {
            "properties": { "evidenceIds": { "minItems": 1 } }
          }
        }
      ]
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "requiresChange"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "requiresChange": { "type": "boolean" }
      }
    }
  }
}
