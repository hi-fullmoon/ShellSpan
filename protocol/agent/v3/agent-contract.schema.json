{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shellspan.local/protocol/agent/v3/agent-contract.schema.json",
  "title": "ShellSpan Agent Contract v3 draft and fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "examples"],
  "properties": {
    "contractVersion": { "const": 3 },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "verifiedCapability", "toolCalls", "toolResults"],
      "properties": {
        "request": { "$ref": "#/$defs/agentRequest" },
        "verifiedCapability": { "$ref": "#/$defs/verifiedCapabilityClaims" },
        "toolCalls": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "$ref": "https://shellspan.local/protocol/agent/v3/tool-contract.schema.json#/$defs/agentToolCall"
          }
        },
        "toolResults": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "$ref": "https://shellspan.local/protocol/agent/v3/tool-contract.schema.json#/$defs/agentToolResult"
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "$ref": "https://shellspan.local/protocol/agent/v3/tool-contract.schema.json#/$defs/identifier"
    },
    "permissionMode": {
      "enum": ["requestApproval", "scopedAutopilot", "operator"]
    },
    "sourceContract": {
      "enum": ["v3", "v2Compatibility"]
    },
    "agentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "userSessionId",
        "taskId",
        "goal",
        "successCriteria",
        "targets",
        "permissionMode",
        "sourceContract"
      ],
      "properties": {
        "contractVersion": { "const": 3 },
        "requestId": { "$ref": "#/$defs/identifier" },
        "userSessionId": { "$ref": "#/$defs/identifier" },
        "taskId": { "$ref": "#/$defs/identifier" },
        "goal": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "successCriteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "https://shellspan.local/protocol/agent/v3/tool-contract.schema.json#/$defs/toolTarget"
          }
        },
        "permissionMode": { "$ref": "#/$defs/permissionMode" },
        "sourceContract": { "$ref": "#/$defs/sourceContract" }
      }
    },
    "verifiedCapabilityClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId",
        "requestId",
        "userSessionId",
        "allowedTools",
        "allowedEffects",
        "targetIds",
        "notBeforeUnixMs",
        "expiresAtUnixMs",
        "revoked"
      ],
      "properties": {
        "capabilityId": { "$ref": "#/$defs/identifier" },
        "requestId": { "$ref": "#/$defs/identifier" },
        "userSessionId": { "$ref": "#/$defs/identifier" },
        "allowedTools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "https://shellspan.local/protocol/agent/v3/tool-contract.schema.json#/$defs/toolName"
          }
        },
        "allowedEffects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "https://shellspan.local/protocol/agent/v3/tool-contract.schema.json#/$defs/effectKind"
          }
        },
        "targetIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "notBeforeUnixMs": { "type": "integer", "minimum": 0 },
        "expiresAtUnixMs": { "type": "integer", "minimum": 1 },
        "revoked": { "type": "boolean" }
      }
    }
  }
}
