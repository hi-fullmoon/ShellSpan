{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://termbridge.app/protocol/agent/v2/agent-snapshot.schema.json",
  "title": "TermBridge AgentRunSnapshotV2",
  "description": "Strict backend-authoritative P2 Agent run snapshot without consumable approval secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "lastSequence",
    "state",
    "target",
    "provider",
    "policy",
    "budgets",
    "goal",
    "plan",
    "toolCalls",
    "evidence",
    "queuedSteeringCount",
    "riskAssessments",
    "changes",
    "verificationObligations"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "runId": { "$ref": "#/$defs/identifier" },
    "lastSequence": { "type": "integer", "minimum": 0 },
    "state": { "$ref": "#/$defs/runState" },
    "target": { "$ref": "#/$defs/target" },
    "provider": { "$ref": "#/$defs/provider" },
    "policy": { "$ref": "#/$defs/policy" },
    "budgets": { "$ref": "#/$defs/budgetSnapshot" },
    "goal": { "type": "string", "minLength": 1, "maxLength": 8192, "pattern": "\\S" },
    "plan": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/planItem" } },
    "toolCalls": { "type": "array", "maxItems": 15, "items": { "$ref": "#/$defs/toolCall" } },
    "evidence": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/evidence" } },
    "pendingQuestion": { "$ref": "#/$defs/question" },
    "queuedSteeringCount": { "type": "integer", "minimum": 0, "maximum": 16 },
    "report": { "$ref": "#/$defs/finalReport" },
    "error": { "$ref": "#/$defs/publicError" },
    "pendingApproval": { "$ref": "#/$defs/approval" },
    "riskAssessments": {
      "type": "array",
      "maxItems": 15,
      "items": { "$ref": "#/$defs/riskAssessment" }
    },
    "changes": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/changeSnapshot" } },
    "verificationObligations": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/verification" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "nonEmptyText": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
    "runState": {
      "enum": [
        "created",
        "collectingContext",
        "thinking",
        "validatingTool",
        "evaluatingRisk",
        "awaitingApproval",
        "executingTool",
        "executingChange",
        "verifyingChange",
        "observing",
        "awaitingUser",
        "pausing",
        "paused",
        "cancelling",
        "completed",
        "failed",
        "cancelled",
        "blocked"
      ]
    },
    "toolState": {
      "enum": [
        "proposed",
        "validating",
        "policyEvaluated",
        "awaitingApproval",
        "approved",
        "rejected",
        "expired",
        "revoked",
        "executing",
        "awaitingVerification",
        "verifying",
        "completed",
        "partial",
        "failed",
        "timedOut",
        "cancelled",
        "unknownEffect",
        "denied"
      ]
    },
    "planItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
        "status": { "enum": ["pending", "active", "completed", "skipped"] }
      }
    },
    "jumpTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "username", "authMethod"],
      "properties": {
        "host": { "$ref": "#/$defs/nonEmptyText" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "username": { "$ref": "#/$defs/nonEmptyText" },
        "authMethod": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "profileLabel",
        "host",
        "port",
        "username",
        "authMethod",
        "targetDigest"
      ],
      "properties": {
        "profileId": { "$ref": "#/$defs/identifier" },
        "profileLabel": { "$ref": "#/$defs/nonEmptyText" },
        "host": { "$ref": "#/$defs/nonEmptyText" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "username": { "$ref": "#/$defs/nonEmptyText" },
        "authMethod": { "$ref": "#/$defs/nonEmptyText" },
        "jumpHost": { "$ref": "#/$defs/jumpTarget" },
        "targetDigest": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "providerCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "streaming",
        "strictJsonSchema",
        "nativeToolCalling",
        "usageReporting",
        "responseContinuation"
      ],
      "properties": {
        "streaming": { "type": "boolean" },
        "strictJsonSchema": { "type": "boolean" },
        "nativeToolCalling": { "type": "boolean" },
        "usageReporting": { "type": "boolean" },
        "responseContinuation": { "type": "boolean" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "kind", "baseUrl", "model", "capabilities"],
      "properties": {
        "providerId": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["ollama", "openAi", "openAiCompatible"] },
        "baseUrl": { "$ref": "#/$defs/nonEmptyText" },
        "model": { "$ref": "#/$defs/nonEmptyText" },
        "capabilities": { "$ref": "#/$defs/providerCapabilities" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "policyVersion", "toolRegistryVersion", "allowedTools", "controlledMutationAllowed"],
      "properties": {
        "mode": { "enum": ["strict", "balanced"] },
        "policyVersion": { "$ref": "#/$defs/identifier" },
        "toolRegistryVersion": { "$ref": "#/$defs/identifier" },
        "allowedTools": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "host.inspect",
              "shell.execReadOnly",
              "service.inspect",
              "service.validateConfig",
              "service.control"
            ]
          }
        },
        "controlledMutationAllowed": { "type": "boolean" }
      }
    },
    "budgetPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxRunSeconds",
        "maxModelTurns",
        "maxToolCalls",
        "toolTimeoutSeconds",
        "maxConsecutiveInvalidDecisions",
        "maxConsecutiveToolFailures",
        "maxPendingPlanItems",
        "maxSteeringQueueItems",
        "maxUserMessageBytes",
        "stdoutCaptureBytes",
        "stderrCaptureBytes",
        "totalReadHardLimitBytes",
        "maxMutationProposals",
        "maxApprovedMutations",
        "maxPendingApprovals",
        "maxVerificationAttemptsPerChange",
        "maxVerificationRuntimeSeconds"
      ],
      "properties": {
        "maxRunSeconds": { "type": "integer", "minimum": 1, "maximum": 900 },
        "maxModelTurns": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maxToolCalls": { "type": "integer", "minimum": 1, "maximum": 15 },
        "toolTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "maxConsecutiveInvalidDecisions": { "type": "integer", "minimum": 1, "maximum": 2 },
        "maxConsecutiveToolFailures": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maxPendingPlanItems": { "type": "integer", "minimum": 1, "maximum": 8 },
        "maxSteeringQueueItems": { "type": "integer", "minimum": 1, "maximum": 16 },
        "maxUserMessageBytes": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "stdoutCaptureBytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "stderrCaptureBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "totalReadHardLimitBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "maxMutationProposals": { "type": "integer", "minimum": 1, "maximum": 5 },
        "maxApprovedMutations": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maxPendingApprovals": { "const": 1 },
        "maxVerificationAttemptsPerChange": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maxVerificationRuntimeSeconds": { "type": "integer", "minimum": 1, "maximum": 120 }
      }
    },
    "budgetUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsedMillis",
        "modelTurnsUsed",
        "toolCallsUsed",
        "consecutiveInvalidDecisions",
        "consecutiveToolFailures",
        "steeringQueueItems",
        "mutationProposalsUsed",
        "approvedMutationsUsed",
        "pendingApprovals"
      ],
      "properties": {
        "elapsedMillis": { "type": "integer", "minimum": 0 },
        "modelTurnsUsed": { "type": "integer", "minimum": 0, "maximum": 20 },
        "toolCallsUsed": { "type": "integer", "minimum": 0, "maximum": 15 },
        "consecutiveInvalidDecisions": { "type": "integer", "minimum": 0, "maximum": 2 },
        "consecutiveToolFailures": { "type": "integer", "minimum": 0, "maximum": 3 },
        "steeringQueueItems": { "type": "integer", "minimum": 0, "maximum": 16 },
        "mutationProposalsUsed": { "type": "integer", "minimum": 0, "maximum": 5 },
        "approvedMutationsUsed": { "type": "integer", "minimum": 0, "maximum": 3 },
        "pendingApprovals": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    },
    "budgetSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "policy", "usage"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "policy": { "$ref": "#/$defs/budgetPolicy" },
        "usage": { "$ref": "#/$defs/budgetUsage" }
      }
    },
    "publicError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "category", "message", "retryable"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "category": {
          "enum": [
            "agentBusy",
            "targetUnavailable",
            "providerIncompatible",
            "providerUnavailable",
            "providerProtocol",
            "toolDenied",
            "toolFailed",
            "staleEvidence",
            "preconditionFailed",
            "approvalRequired",
            "approvalExpired",
            "verificationFailed",
            "budgetExceeded",
            "cancelled",
            "p2Blocked",
            "policyUnavailable",
            "internal"
          ]
        },
        "message": { "$ref": "#/$defs/nonEmptyText" },
        "retryable": { "type": "boolean" },
        "suggestion": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "toolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "runId",
        "toolCallId",
        "status",
        "startedAt",
        "completedAt",
        "stdoutExcerpt",
        "stderrExcerpt",
        "stdoutBytesCaptured",
        "stderrBytesCaptured",
        "stdoutBytesRead",
        "stderrBytesRead",
        "stdoutTruncated",
        "stderrTruncated"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "runId": { "$ref": "#/$defs/identifier" },
        "toolCallId": { "$ref": "#/$defs/identifier" },
        "status": { "enum": ["completed", "partial", "failed", "timedOut", "cancelled", "unknownEffect", "denied"] },
        "startedAt": { "type": "integer", "minimum": 0 },
        "completedAt": { "type": "integer", "minimum": 0 },
        "exitCode": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "stdoutExcerpt": { "type": "string", "maxLength": 262144 },
        "stderrExcerpt": { "type": "string", "maxLength": 65536 },
        "stdoutBytesCaptured": { "type": "integer", "minimum": 0 },
        "stderrBytesCaptured": { "type": "integer", "minimum": 0 },
        "stdoutBytesRead": { "type": "integer", "minimum": 0 },
        "stderrBytesRead": { "type": "integer", "minimum": 0 },
        "stdoutTruncated": { "type": "boolean" },
        "stderrTruncated": { "type": "boolean" },
        "error": { "$ref": "#/$defs/publicError" }
      }
    },
    "toolCallBaseProperties": {
      "type": "object"
    },
    "toolCall": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["toolCallId", "state", "tool", "arguments", "rationale", "purpose", "successCriteria", "proposedAt", "evidenceIds"],
          "properties": {
            "toolCallId": { "$ref": "#/$defs/identifier" },
            "state": { "$ref": "#/$defs/toolState" },
            "tool": { "const": "host.inspect" },
            "arguments": { "$ref": "agent-decision.schema.json#/$defs/hostInspectArguments" },
            "rationale": { "$ref": "agent-decision.schema.json#/$defs/rationale" },
            "purpose": { "$ref": "agent-decision.schema.json#/$defs/toolText" },
            "successCriteria": { "$ref": "agent-decision.schema.json#/$defs/toolText" },
            "proposedAt": { "type": "integer", "minimum": 0 },
            "operationId": { "$ref": "#/$defs/identifier" },
            "commandPreview": { "type": "string", "minLength": 1, "maxLength": 8192, "pattern": "\\S" },
            "result": { "$ref": "#/$defs/toolResult" },
            "evidenceIds": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/identifier" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["toolCallId", "state", "tool", "arguments", "rationale", "purpose", "successCriteria", "proposedAt", "evidenceIds"],
          "properties": {
            "toolCallId": { "$ref": "#/$defs/identifier" },
            "state": { "$ref": "#/$defs/toolState" },
            "tool": { "const": "shell.execReadOnly" },
            "arguments": { "$ref": "agent-decision.schema.json#/$defs/shellExecReadOnlyArguments" },
            "rationale": { "$ref": "agent-decision.schema.json#/$defs/rationale" },
            "purpose": { "$ref": "agent-decision.schema.json#/$defs/toolText" },
            "successCriteria": { "$ref": "agent-decision.schema.json#/$defs/toolText" },
            "proposedAt": { "type": "integer", "minimum": 0 },
            "operationId": { "$ref": "#/$defs/identifier" },
            "commandPreview": { "type": "string", "minLength": 1, "maxLength": 8192, "pattern": "\\S" },
            "result": { "$ref": "#/$defs/toolResult" },
            "evidenceIds": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/identifier" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["toolCallId", "state", "tool", "arguments", "rationale", "purpose", "successCriteria", "proposedAt", "evidenceIds"],
          "properties": {
            "toolCallId": { "$ref": "#/$defs/identifier" },
            "state": { "$ref": "#/$defs/toolState" },
            "tool": { "const": "service.inspect" },
            "arguments": { "$ref": "agent-decision.schema.json#/$defs/serviceInspectArguments" },
            "rationale": { "$ref": "agent-decision.schema.json#/$defs/rationale" },
            "purpose": { "$ref": "agent-decision.schema.json#/$defs/toolText" },
            "successCriteria": { "$ref": "agent-decision.schema.json#/$defs/toolText" },
            "proposedAt": { "type": "integer", "minimum": 0 },
            "operationId": { "$ref": "#/$defs/identifier" },
            "commandPreview": { "type": "string", "minLength": 1, "maxLength": 8192, "pattern": "\\S" },
            "result": { "$ref": "#/$defs/toolResult" },
            "evidenceIds": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/identifier" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["toolCallId", "state", "tool", "arguments", "rationale", "purpose", "successCriteria", "proposedAt", "evidenceIds"],
          "properties": {
            "toolCallId": { "$ref": "#/$defs/identifier" },
            "state": { "$ref": "#/$defs/toolState" },
            "tool": { "const": "service.validateConfig" },
            "arguments": { "$ref": "agent-decision.schema.json#/$defs/serviceValidateConfigArguments" },
            "rationale": { "$ref": "agent-decision.schema.json#/$defs/rationale" },
            "purpose": { "$ref": "agent-decision.schema.json#/$defs/toolText" },
            "successCriteria": { "$ref": "agent-decision.schema.json#/$defs/toolText" },
            "proposedAt": { "type": "integer", "minimum": 0 },
            "operationId": { "$ref": "#/$defs/identifier" },
            "commandPreview": { "type": "string", "minLength": 1, "maxLength": 8192, "pattern": "\\S" },
            "result": { "$ref": "#/$defs/toolResult" },
            "evidenceIds": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/identifier" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "toolCallId",
            "state",
            "tool",
            "arguments",
            "rationale",
            "purpose",
            "expectedImpact",
            "rollbackGuidance",
            "successCriteria",
            "preconditionEvidenceIds",
            "retrySafety",
            "proposedAt",
            "evidenceIds"
          ],
          "properties": {
            "toolCallId": { "$ref": "#/$defs/identifier" },
            "state": { "$ref": "#/$defs/toolState" },
            "tool": { "const": "service.control" },
            "arguments": { "$ref": "agent-decision.schema.json#/$defs/serviceControlArguments" },
            "rationale": { "$ref": "agent-decision.schema.json#/$defs/rationale" },
            "purpose": { "$ref": "agent-decision.schema.json#/$defs/toolText" },
            "expectedImpact": { "$ref": "agent-decision.schema.json#/$defs/toolText" },
            "rollbackGuidance": { "$ref": "agent-decision.schema.json#/$defs/toolText" },
            "successCriteria": { "$ref": "agent-decision.schema.json#/$defs/toolText" },
            "preconditionEvidenceIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": { "$ref": "#/$defs/identifier" }
            },
            "retrySafety": { "enum": ["never", "verifyBeforeRetry"] },
            "proposedAt": { "type": "integer", "minimum": 0 },
            "operationId": { "$ref": "#/$defs/identifier" },
            "commandPreview": { "type": "string", "minLength": 1, "maxLength": 8192, "pattern": "\\S" },
            "result": { "$ref": "#/$defs/toolResult" },
            "evidenceIds": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/identifier" } }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "runId", "targetDigest", "source", "observedAt", "summary", "truncated", "observationDigest"],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/identifier" },
        "runId": { "$ref": "#/$defs/identifier" },
        "targetDigest": { "$ref": "#/$defs/nonEmptyText" },
        "source": {
          "enum": [
            "terminalSnapshot",
            "host.inspect",
            "shell.execReadOnly",
            "service.inspect",
            "service.validateConfig",
            "service.control",
            "service.verify"
          ]
        },
        "toolCallId": { "$ref": "#/$defs/identifier" },
        "observedAt": { "type": "integer", "minimum": 0 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S" },
        "stdoutExcerpt": { "type": "string", "maxLength": 262144 },
        "stderrExcerpt": { "type": "string", "maxLength": 65536 },
        "exitCode": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "truncated": { "type": "boolean" },
        "observationDigest": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "resource": { "$ref": "agent-decision.schema.json#/$defs/resource" },
    "riskDimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write", "delete", "privilegeElevation", "serviceInterruption", "networkChange", "credentialAccess", "externalNetwork", "multiHost"],
      "properties": {
        "read": { "type": "boolean" },
        "write": { "type": "boolean" },
        "delete": { "type": "boolean" },
        "privilegeElevation": { "type": "boolean" },
        "serviceInterruption": { "type": "boolean" },
        "networkChange": { "type": "boolean" },
        "credentialAccess": { "type": "boolean" },
        "externalNetwork": { "type": "boolean" },
        "multiHost": { "type": "boolean" }
      }
    },
    "riskFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/identifier" },
        "message": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "riskAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["riskAssessmentId", "severity", "confidence", "dimensions", "findings", "affectedResources", "verdict", "policyVersion", "assessmentDigest"],
      "properties": {
        "riskAssessmentId": { "$ref": "#/$defs/identifier" },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "confidence": { "enum": ["known", "heuristic", "unknown"] },
        "dimensions": { "$ref": "#/$defs/riskDimensions" },
        "findings": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/riskFinding" } },
        "affectedResources": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/resource" } },
        "verdict": { "enum": ["autoReadOnly", "requiresApproval", "requiresDoubleConfirmation", "deny"] },
        "policyVersion": { "$ref": "#/$defs/identifier" },
        "assessmentDigest": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvalId", "runId", "toolCallId", "toolName", "riskAssessmentId", "commandPreview", "preconditionEvidenceIds", "timeoutSeconds", "issuedAt", "expiresAt", "confirmationMode", "state"],
      "properties": {
        "approvalId": { "$ref": "#/$defs/identifier" },
        "runId": { "$ref": "#/$defs/identifier" },
        "toolCallId": { "$ref": "#/$defs/identifier" },
        "toolName": {
          "enum": ["host.inspect", "shell.execReadOnly", "service.inspect", "service.validateConfig", "service.control"]
        },
        "resource": { "$ref": "#/$defs/resource" },
        "riskAssessmentId": { "$ref": "#/$defs/identifier" },
        "commandPreview": { "type": "string", "minLength": 1, "maxLength": 8192, "pattern": "\\S" },
        "preconditionEvidenceIds": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/identifier" } },
        "verificationPlanDigest": { "$ref": "#/$defs/nonEmptyText" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "issuedAt": { "type": "integer", "minimum": 0 },
        "expiresAt": { "type": "integer", "minimum": 0 },
        "confirmationMode": { "enum": ["single", "double"] },
        "state": { "enum": ["pending", "confirmationPending", "approved", "consuming"] }
      },
      "allOf": [
        {
          "if": { "properties": { "toolName": { "const": "service.control" } }, "required": ["toolName"] },
          "then": {
            "type": "object",
            "required": ["resource", "verificationPlanDigest"],
            "properties": {
              "resource": { "$ref": "#/$defs/resource" },
              "verificationPlanDigest": { "$ref": "#/$defs/nonEmptyText" },
              "preconditionEvidenceIds": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "changeSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changeId", "toolCallId", "approvalId", "resource", "action", "status", "executionEvidenceIds", "verificationEvidenceIds", "recordedAt"],
      "properties": {
        "changeId": { "$ref": "#/$defs/identifier" },
        "toolCallId": { "$ref": "#/$defs/identifier" },
        "approvalId": { "$ref": "#/$defs/identifier" },
        "resource": { "$ref": "#/$defs/resource" },
        "action": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "\\S" },
        "status": { "enum": ["verified", "unverified", "failedNoEffect", "executionSucceededVerificationFailed", "partialUnexpectedEffect", "unknownEffect"] },
        "executionEvidenceIds": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/identifier" } },
        "verificationEvidenceIds": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/identifier" } },
        "operationId": { "$ref": "#/$defs/identifier" },
        "recordedAt": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "verified" } }, "required": ["status"] },
          "then": {
            "properties": {
              "verificationEvidenceIds": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verificationObligationId", "changeId", "toolCallId", "state", "verificationPlanDigest", "evidenceIds"],
      "properties": {
        "verificationObligationId": { "$ref": "#/$defs/identifier" },
        "changeId": { "$ref": "#/$defs/identifier" },
        "toolCallId": { "$ref": "#/$defs/identifier" },
        "state": { "enum": ["pending", "running", "satisfied", "failed", "inconclusive", "timedOut", "cancelled"] },
        "verificationPlanDigest": { "$ref": "#/$defs/nonEmptyText" },
        "evidenceIds": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/identifier" } },
        "startedAt": { "type": "integer", "minimum": 0 },
        "completedAt": { "type": "integer", "minimum": 0 }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "question", "askedAt"],
      "properties": {
        "questionId": { "$ref": "#/$defs/identifier" },
        "question": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S" },
        "askedAt": { "type": "integer", "minimum": 0 }
      }
    },
    "finalReport": { "$ref": "agent-decision.schema.json#/$defs/finalReport" }
  }
}
