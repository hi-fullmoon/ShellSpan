{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://termbridge.app/protocol/agent-terminal/v1/terminal-actions.schema.json",
  "title": "TermBridge Agent Terminal Semantic Action v1",
  "description": "Model-facing semantic actions. Session identities, lease tokens, and PTY bytes are intentionally absent.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "action", "actionId", "driver", "program", "arguments"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "const": "terminal.start" },
        "actionId": { "$ref": "#/$defs/identifier" },
        "driver": { "const": "fixture.shellPrompt" },
        "program": { "const": "termbridge-interactive-fixture" },
        "arguments": { "$ref": "#/$defs/fixtureStartArguments" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "action", "actionId", "observationId", "response"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "const": "terminal.respond" },
        "actionId": { "$ref": "#/$defs/identifier" },
        "observationId": { "$ref": "#/$defs/identifier" },
        "response": { "enum": ["accept", "decline", "retry", "cancel"] }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "action", "actionId", "observationId", "key"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "const": "terminal.key" },
        "actionId": { "$ref": "#/$defs/identifier" },
        "observationId": { "$ref": "#/$defs/identifier" },
        "key": {
          "enum": [
            "enter",
            "escape",
            "tab",
            "ctrlC",
            "ctrlD",
            "arrowUp",
            "arrowDown",
            "arrowLeft",
            "arrowRight"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "action", "actionId", "observationId", "reason"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "const": "terminal.handoff" },
        "actionId": { "$ref": "#/$defs/identifier" },
        "observationId": { "$ref": "#/$defs/identifier" },
        "reason": {
          "enum": [
            "userRequested",
            "sensitivePrompt",
            "unsupportedInteraction",
            "unknownPrompt"
          ]
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "fixtureStartArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario"],
      "properties": {
        "scenario": { "enum": ["confirm", "choice"] }
      }
    }
  }
}
