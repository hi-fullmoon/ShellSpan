{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://termbridge.local/protocol/runbook/v2/deployment-runbook.schema.json",
  "title": "TermBridge Deployment Runbook v2",
  "description": "Validation-only semantic deployment contract. This schema does not authorize or execute deployment actions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "name",
    "description",
    "deployment",
    "artifacts",
    "release",
    "services",
    "serviceActions",
    "verification",
    "rollback",
    "security"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "deployment" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "$ref": "#/$defs/name" },
    "description": { "$ref": "#/$defs/text" },
    "deployment": { "$ref": "#/$defs/deployment" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "release": { "$ref": "#/$defs/release" },
    "services": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/service" }
    },
    "serviceActions": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/serviceAction" }
    },
    "verification": { "$ref": "#/$defs/verification" },
    "rollback": { "$ref": "#/$defs/rollback" },
    "security": { "$ref": "#/$defs/security" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "risk": {
      "type": "string",
      "enum": ["readOnly", "stateChange", "destructive"]
    },
    "absolutePath": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^/[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "relativePath": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "applicationId", "environment", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "applicationId": { "$ref": "#/$defs/id" },
        "environment": { "$ref": "#/$defs/id" },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
        }
      }
    },
    "unpack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "destinationPath", "stripComponents"],
      "properties": {
        "format": { "enum": ["tar", "tarGz", "zip"] },
        "destinationPath": {
          "oneOf": [
            { "const": "." },
            { "$ref": "#/$defs/relativePath" }
          ]
        },
        "stripComponents": { "type": "integer", "minimum": 0, "maximum": 16 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "kind", "sourceUri", "sha256", "targetPath"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["file", "archive"] },
        "sourceUri": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(https|file)://"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "targetPath": { "$ref": "#/$defs/relativePath" },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000000000
        },
        "credentialRef": { "$ref": "#/$defs/id" },
        "unpack": { "$ref": "#/$defs/unpack" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "archive" } }, "required": ["kind"] },
          "then": { "properties": { "unpack": {} }, "required": ["unpack"] }
        },
        {
          "if": { "properties": { "kind": { "const": "file" } }, "required": ["kind"] },
          "then": { "properties": { "unpack": false } }
        }
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootDirectory",
        "releasesDirectory",
        "releaseDirectory",
        "activeSymlink",
        "activationStrategy"
      ],
      "properties": {
        "rootDirectory": { "$ref": "#/$defs/absolutePath" },
        "releasesDirectory": { "$ref": "#/$defs/absolutePath" },
        "releaseDirectory": { "$ref": "#/$defs/absolutePath" },
        "activeSymlink": { "$ref": "#/$defs/absolutePath" },
        "activationStrategy": { "const": "atomicSymlinkSwap" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "manager", "unit"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "manager": { "const": "systemd" },
        "unit": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9@_.:-]{0,198}\\.service$"
        }
      }
    },
    "serviceAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "serviceId", "action", "risk", "timeoutSeconds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "serviceId": { "$ref": "#/$defs/id" },
        "action": { "enum": ["start", "restart", "reload"] },
        "risk": { "enum": ["stateChange", "destructive"] },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 }
      }
    },
    "httpHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "url", "expectedStatus", "timeoutSeconds", "attempts", "intervalSeconds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "http" },
        "url": { "type": "string", "maxLength": 2048, "pattern": "^https?://" },
        "expectedStatus": { "type": "integer", "minimum": 200, "maximum": 399 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 60 },
        "intervalSeconds": { "type": "integer", "minimum": 1, "maximum": 300 }
      }
    },
    "serviceHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "serviceId", "expectedState", "timeoutSeconds", "attempts", "intervalSeconds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "service" },
        "serviceId": { "$ref": "#/$defs/id" },
        "expectedState": { "const": "active" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 60 },
        "intervalSeconds": { "type": "integer", "minimum": 1, "maximum": 300 }
      }
    },
    "healthCheck": {
      "oneOf": [
        { "$ref": "#/$defs/httpHealth" },
        { "$ref": "#/$defs/serviceHealth" }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/healthCheck" }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "serviceActions", "verificationCheckIds"],
      "properties": {
        "strategy": { "const": "reactivatePreviousRelease" },
        "serviceActions": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/serviceAction" }
        },
        "verificationCheckIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "keychainRef"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "keychainRef": {
          "type": "string",
          "pattern": "^keychain://deployment/[a-z0-9][a-z0-9._-]{0,63}$"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployment", "rollback", "destructive", "targetBinding"],
      "properties": {
        "deployment": { "const": "explicit" },
        "rollback": { "const": "separate" },
        "destructive": { "const": "doubleConfirmation" },
        "targetBinding": { "const": "frozenProfile" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaredRisk", "allowPrivilegeEscalation", "approval", "secretRefs"],
      "properties": {
        "declaredRisk": { "$ref": "#/$defs/risk" },
        "allowPrivilegeEscalation": { "type": "boolean" },
        "approval": { "$ref": "#/$defs/approval" },
        "secretRefs": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/secretRef" }
        }
      }
    }
  }
}
