{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://termbridge.local/protocol/runbook/v2/deployment-rollout.schema.json",
  "title": "TermBridge Deployment Rollout v2 review request",
  "type": "object",
  "additionalProperties": false,
  "required": ["rolloutId", "runbookText", "profileIds", "targets", "policy", "deploymentPolicy"],
  "properties": {
    "rolloutId": { "$ref": "#/$defs/id" },
    "runbookText": { "type": "string", "minLength": 1, "maxLength": 524288 },
    "profileIds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "targets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/target" }
    },
    "policy": { "$ref": "#/$defs/policy" },
    "deploymentPolicy": { "$ref": "#/$defs/deploymentPolicy" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "authMethod": { "enum": ["password", "key"] },
    "jumpHost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "username", "authMethod"],
      "properties": {
        "host": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "username": { "type": "string", "minLength": 1, "maxLength": 256 },
        "authMethod": { "$ref": "#/$defs/authMethod" },
        "password": { "type": "string" },
        "keychainKeyId": { "type": "string" },
        "privateKeyData": { "type": "string" },
        "passphrase": { "type": "string" }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "username", "authMethod"],
      "properties": {
        "profileId": { "$ref": "#/$defs/id" },
        "host": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "username": { "type": "string", "minLength": 1, "maxLength": 256 },
        "authMethod": { "$ref": "#/$defs/authMethod" },
        "password": { "type": "string" },
        "keychainKeyId": { "type": "string" },
        "privateKeyData": { "type": "string" },
        "passphrase": { "type": "string" },
        "jumpHost": { "$ref": "#/$defs/jumpHost" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "environment", "connection"],
      "properties": {
        "profileId": { "$ref": "#/$defs/id" },
        "environment": { "type": "string", "minLength": 1, "maxLength": 128 },
        "connection": { "$ref": "#/$defs/connection" }
      }
    },
    "canary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "value"],
          "properties": {
            "mode": { "const": "count" },
            "value": { "type": "integer", "minimum": 1, "maximum": 499 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "value"],
          "properties": {
            "mode": { "const": "percentage" },
            "value": { "type": "integer", "minimum": 1, "maximum": 99 }
          }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "canary", "batchSize", "maxParallel", "requireBatchApproval", "minHealthyPercent", "maxFailuresPerBatch", "stopPolicy", "rollbackSuggestion"],
      "properties": {
        "strategy": { "const": "canaryRolling" },
        "canary": { "$ref": "#/$defs/canary" },
        "batchSize": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxParallel": { "type": "integer", "minimum": 1, "maximum": 32 },
        "requireBatchApproval": { "const": true },
        "minHealthyPercent": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxFailuresPerBatch": { "type": "integer", "minimum": 0, "maximum": 100 },
        "stopPolicy": { "const": "pause" },
        "rollbackSuggestion": { "enum": ["none", "successfulTargets"] }
      }
    },
    "deploymentPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactTimeoutSeconds", "maxArtifactBytes", "maxExpandedBytes", "maxArchiveEntries", "totalTimeoutSeconds"],
      "properties": {
        "artifactTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "maxArtifactBytes": { "type": "integer", "minimum": 1, "maximum": 2147483648 },
        "maxExpandedBytes": { "type": "integer", "minimum": 1, "maximum": 4294967296 },
        "maxArchiveEntries": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "totalTimeoutSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 }
      }
    }
  }
}
