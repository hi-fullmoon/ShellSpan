# git-cliff --prepend 按字节匹配文件头,CRLF 会导致识别失败、头部重复
CHANGELOG.md text eol=lf

# The Linux SSH subsystem is copied into Docker from Windows worktrees.
scripts/remote-sandbox/shellspan-bwrap-v1 text eol=lf

# Streaming selection tests consume this document by character offset.
AGENTS.md text eol=lf
# Standalone Ajv output is compared byte-for-byte with generated LF source.
src/lib/petdex/diagnostic-validators.js text eol=lf

# Rust golden fixtures are compared with generated LF text. Keep checkout
# bytes deterministic while the tests also tolerate an existing CRLF checkout.
src-tauri/src/agent_runtime/testdata/*.golden.txt text eol=lf

# Native evidence receipts are hashed as captured; checkout must preserve LF bytes.
scripts/__tests__/fixtures/zle-guards-native-20261106/*.json text eol=lf

# Dependency patches and their reviewed inputs must keep identical bytes on
# Windows: pnpm applies patch line endings to the installed xterm artifacts.
patches/@xterm__xterm@6.0.0.patch text eol=lf
scripts/native-input/prototype/*.patch text eol=lf
# Unified-diff context prefixes precede upstream tabs and empty lines. Check
# the applied source hashes; those required prefixes are not source whitespace.
scripts/dependency-builds/zsh/*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
patches/psreadline-2.4.5-process-exit.patch text eol=lf
scripts/dependency-builds/psreadline/*.json text eol=lf
patches/psreadline-2.4.5-history-and-resize.patch text eol=lf
src-tauri/resources/powershell/PSReadLine/2.4.5/XTERM-LICENSE text eol=lf
