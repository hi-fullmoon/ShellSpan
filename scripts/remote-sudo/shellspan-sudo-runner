#!/usr/bin/python3 -I
"""Restricted, single-use SSH subsystem for administrator-owned sudo jobs."""

import hashlib
import json
import os
from pathlib import Path
import pwd
import selectors
import stat
import subprocess
import sys
import time
import uuid

RUNNER = "/usr/local/libexec/shellspan-sudo-runner"
POLICY = Path("/etc/shellspan-sudo/jobs.json")
JOBS = Path("/usr/local/libexec/shellspan-sudo-jobs")
LIMIT = 32768
ENVIRONMENT = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C", "HOME": "/"}


def trusted_file(path):
    if not path.is_absolute() or ".." in path.parts:
        raise ValueError("untrusted file path")
    for component in (*reversed(path.parents), path):
        metadata = component.lstat()
        if metadata.st_uid != 0 or metadata.st_mode & 0o022 or stat.S_ISLNK(metadata.st_mode):
            raise ValueError("untrusted file ownership or permissions")
    if not stat.S_ISREG(path.lstat().st_mode):
        raise ValueError("expected a regular file")
    return path


def read_bounded(path, limit):
    with trusted_file(path).open("rb") as source:
        data = source.read(limit + 1)
    if len(data) > limit:
        raise ValueError("administrator file exceeds the limit")
    return data


def snapshot(request):
    policy_bytes = read_bounded(POLICY, 65536)
    policy = json.loads(policy_bytes)
    if not os.geteuid() or pwd.getpwuid(os.geteuid()).pw_name != policy["runnerUser"]:
        raise ValueError("incorrect runner account")
    operation = policy["operations"][request["operation"]]
    argv = operation["argv"]
    if not isinstance(argv, list) or not argv or any(
        not isinstance(arg, str) or "\0" in arg for arg in argv
    ) or argv != request["argv"]:
        raise ValueError("operation does not match the remote policy")
    executable = Path(argv[0])
    if executable.parent != JOBS:
        raise ValueError("operation must be an administrator-installed job")
    inputs = operation["trustedInputs"]
    if not isinstance(inputs, list) or len(inputs) > 32:
        raise ValueError("incorrect trusted inputs")
    revision = hashlib.sha256(policy_bytes)
    for path in [executable, *(Path(item) for item in inputs)]:
        contents = read_bounded(path, 16 * 1024 * 1024)
        if path == executable and not contents.startswith(b"#!/bin/sh\n"):
            raise ValueError("expected an administrator-installed POSIX job wrapper")
        revision.update(hashlib.sha256(contents).digest())
    return revision.digest(), argv


def read_frame(kind, fields):
    line = sys.stdin.buffer.readline(16385)
    if not line.endswith(b"\n") or len(line) > 16384:
        raise ValueError("incomplete runner request")
    frame = json.loads(line)
    if not isinstance(frame, dict) or set(frame) != {"type", *fields} or frame["type"] != kind:
        raise ValueError("invalid runner request")
    return frame


def reply(**frame):
    print(json.dumps(frame, ensure_ascii=True, separators=(",", ":")), flush=True)


def run_job(argv):
    child = subprocess.Popen(
        ["/usr/bin/sudo", "-n", "--", *argv], stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, cwd="/", env=ENVIRONMENT,
    )
    output = [bytearray(), bytearray()]
    truncated = False
    deadline = time.monotonic() + 180
    try:
        with selectors.DefaultSelector() as poll:
            for index, stream in enumerate((child.stdout, child.stderr)):
                poll.register(stream, selectors.EVENT_READ, index)
            while poll.get_map():
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise TimeoutError
                for key, _ in poll.select(remaining):
                    chunk = os.read(key.fd, 4096)
                    if not chunk:
                        poll.unregister(key.fileobj)
                        continue
                    space = LIMIT - len(output[key.data])
                    output[key.data].extend(chunk[:space])
                    truncated |= len(chunk) > space
        code = child.wait(timeout=max(0, deadline - time.monotonic()))
    finally:
        if child.poll() is None:
            # Do not issue a definitive reply when sudo might have dispatched.
            try:
                child.terminate()
            except ProcessLookupError:
                pass
    return (128 - code if code < 0 else code), [data.decode("utf-8", "replace") for data in output], truncated


def main():
    if sys.argv[1:] != ["-c", RUNNER] or os.environ.get("SSH_ORIGINAL_COMMAND") != RUNNER:
        return 1
    try:
        request = read_frame("prepare", {"operation", "argv"})
        revision, argv = snapshot(request)
        receipt = str(uuid.uuid4())
        reply(type="ready", receipt=receipt)
        if read_frame("dispatch", {"receipt"})["receipt"] != receipt or snapshot(request)[0] != revision:
            raise ValueError("remote policy changed")
    except (KeyError, OSError, TypeError, ValueError):
        reply(type="rejected", message="The restricted runner denied the operation before dispatch.")
        return
    # Errors beyond this boundary close the subsystem without a result. The
    # client must reconcile instead of retrying an unconfirmed operation.
    code, (stdout, stderr), truncated = run_job(argv)
    reply(type="completed", receipt=receipt, exitCode=code, stdout=stdout, stderr=stderr, truncated=truncated)


if __name__ == "__main__":
    raise SystemExit(main())
