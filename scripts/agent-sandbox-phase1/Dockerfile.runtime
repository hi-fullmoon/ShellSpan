FROM shellspan-agent-sandbox-phase1:local AS sandbox
FROM rust:1.95-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake libayatana-appindicator3-dev libdbus-1-dev libgtk-3-dev librsvg2-dev \
    libssl-dev libwebkit2gtk-4.1-dev libxdo-dev pkg-config procps \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 shellspan
COPY --from=sandbox /phase1/nono-probe /usr/local/bin/shellspan-sandbox-probe
COPY --from=sandbox /usr/local/bin/node /usr/local/bin/node
ENV CARGO_HOME=/home/shellspan/.cargo
USER shellspan
WORKDIR /home/shellspan
