--- a/jobs.c
+++ b/jobs.c
@@ -68,6 +68,9 @@
 #include "shell.h"
 #include "parser.h"
 #include "jobs.h"
+#if defined (__APPLE__)
+#  include "shellspan-darwin-setpgid.h"
+#endif
 #include "execute_cmd.h"
 #include "flags.h"

@@ -2268,6 +2271,9 @@ make_child (char *command, int flags)
   unsigned int forksleep;
   sigset_t set, oset, oset_copy;
   pid_t pid;
+#if defined (__APPLE__)
+  int shellspan_pgrp_pipe[2];
