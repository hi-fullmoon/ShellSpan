+/* Backport the owned visible-line clearing used by Readline 8.3's resize
+   path. Only rows occupied by this editor line are erased, not history. */
+static void
+clear_visible_line_for_resize (void)
+{
+  int curr_line;
+
+  cr ();
+  _rl_move_vert (_rl_vis_botlin);
+  for (curr_line = _rl_last_v_pos; curr_line >= 0; curr_line--)
+    {
+      _rl_move_vert (curr_line);
+      _rl_clear_to_eol (_rl_screenwidth);
+      cr ();
+    }
+}
