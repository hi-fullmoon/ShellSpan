+/**/
+mod_export void
+hist_native_bind(char *plan, char *source)
+{
+    if (native_history_source || native_history_plan || !histactive ||
+        (histactive & HA_NOINC)) {
+        zsfree(plan);
+        zsfree(source);
+        zerr("invalid native history handoff context");
+        return;
+    }
+    native_history_source = source;
+    native_history_plan = plan;
+    /* Approved source was parsed non-interactively before acceptance. Do not
+     * introduce interactive bang expansion while consuming its fixed plan. */
+    if (!stophist) stophist = 1;
+}
 
+/**/
+mod_export int
+hist_native_continuation(void)
+{
+    if (!native_history_source) return 0;
+    if (native_history_plan) zsfree(native_history_plan);
+    native_history_plan = NULL;
+    zerr("native plan requested unbound continuation input");
+    return 1;
+}
