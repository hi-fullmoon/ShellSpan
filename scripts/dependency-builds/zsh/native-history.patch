+/* Metadata binding only. The caller still owns all NIP proof, durable intent
+ * and accept authorization; this API cannot accept or execute a line. */
+/**/
+mod_export int
+zle_native_bind_handoff(const char *source, const char *plan)
+{
+    char *actual;
+    if (!zleactive || !done || zlecontext != ZLCON_LINE_START ||
+        zle_native_append_mode != 1 || native_handoff_source ||
+        zle_native_history_api() != 1 ||
+        !source || !*source || !plan || !*plan ||
+        strlen(source) > 16384 || strlen(plan) > 65536) {
+        zerr("invalid native source/plan binding");
+        return 1;
+    }
+    actual = zlegetline(NULL, NULL);
+    if (strcmp(actual, source)) {
+        zsfree(actual);
+        zerr("native source changed before plan binding");
+        return 1;
+    }
+    zsfree(actual);
+    native_handoff_source = ztrdup(source);
+    native_handoff_plan = ztrdup(plan);
+    return 0;
+}
