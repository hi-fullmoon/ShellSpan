+/**/
+static int
+native_history_apply(Eprog *history_prog)
+{
+    char *source = native_history_source, *plan = native_history_plan;
+    char *replacement;
+    short *words = NULL;
+    int wordlen = 0, wordpos = 0, length;
+    native_history_source = native_history_plan = NULL;
+    if (!source) return 1;
+    if (!plan || !chline) {
+        zsfree(source);
+        if (plan) zsfree(plan);
+        zerr("native history handoff was not completely bound");
+        return 0;
+    }
+    zsfree(plan);
+    histsplitwords(source, &words, &wordlen, &wordpos, 1);
+    if (!errflag && (isset(HISTNOFUNCTIONS) || isset(HISTNOSTORE))) {
+        *history_prog = parse_string(source, 1);
+        if (!*history_prog) errflag |= ERRFLAG_ERROR;
+    }
+    if (errflag) {
+        if (words) zfree(words, wordlen * sizeof(short));
+        zsfree(source);
+        return 0;
+    }
+    length = strlen(source);
