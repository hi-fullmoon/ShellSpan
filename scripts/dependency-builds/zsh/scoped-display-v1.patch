+/* Expand HT from the native prompt and actual editor prefix.  A terminal HT
+ * clips at its right margin, so passing the raw byte through loses spaces.
+ * This computes only a source tab stop; the terminal still owns all wrapping,
+ * resizing and cursor placement.  libc decodes the existing native bytes. */
+static int
+native_append_tab_spaces(const char *text, int end)
+{
+    size_t column = lpromptw, offset = 0;
+#ifdef MULTIBYTE_SUPPORT
+    mbstate_t state;
+    memset(&state, 0, sizeof(state));
 #endif
+    while (offset < (size_t)end) {
+	size_t count = 1;
+	int width = 1;
+	unsigned char character = (unsigned char)text[offset];
+	if (character == '\n')
+	    column = 0;
+	else if (character == '\r')
+	    column += 2;
+	else if (character == '\t')
+	    column += 8 - column % 8;
+	else {
+#ifdef MULTIBYTE_SUPPORT
+	    wchar_t wc;
+	    count = mbrtowc(&wc, text + offset, end - offset, &state);
+	    if (count == (size_t)-1 || count == (size_t)-2 || !count) {
+		memset(&state, 0, sizeof(state));
+		count = 1;
+	    } else {
+		width = wcwidth(wc);
+		if (width < 0)
+		    width = 2;
+	    }
+#endif
+	    column += width;
+	}
+	offset += count;
+    }
+    return 8 - column % 8;
+}
+
+static void
+native_append_refresh(void)
+{
+    int length, cursor, i;
+    char *text;
+    if (native_append_handoff)
+	return;
+    if (trashedzle) {
+	zsetterm();
+	trashedzle = 0;
+    }
+    text = zlegetline(&length, &cursor);
+    if (cursor != length) {
+	zsfree(text);
+	return;
+    }
+    unmetafy(text, &length);
+    if (!length && native_append_bytes) {
+	zle_owned_append_stop();
+    } else if ((size_t)length >= native_append_bytes) {
+	for (i = (int)native_append_bytes; i < length; i++) {
+	    if (text[i] == '\r')
+		fputs("^M", shout);
+	    else if (text[i] == '\t') {
+		int spaces = native_append_tab_spaces(text, i);
+		while (spaces--)
+		    fputc(' ', shout);
+	    }
+	    else
+		fputc((unsigned char)text[i], shout);
+	}
+	fflush(shout);
+	if ((size_t)length > native_append_bytes)
+	    native_append_closed = 0;
+	native_append_bytes = (size_t)length;
+    }
+    zsfree(text);
 }
 
