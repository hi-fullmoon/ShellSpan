{
  "name": "shellspan",
  "private": true,
  "version": "2.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 1420",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:scripts": "vitest run scripts/__tests__",
    "test:agent:security": "vitest run src/lib/__tests__/agent-terminal-executor.test.ts src/lib/__tests__/safe-shell-command.test.ts src/lib/__tests__/agent-command-risk.test.ts src/lib/__tests__/agent-approval-controller.test.ts src/lib/__tests__/agent-ui-controller.test.ts src/lib/__tests__/agent-sessions.test.ts src/lib/__tests__/terminal-output-buffer.test.ts src/stores/__tests__/agentPermissionStore.test.ts",
    "test:agent:contract-v3": "vitest run src/lib/__tests__/agent-contract-v3.test.ts --maxWorkers=1",
    "test:agent:runtime-v3": "vitest run src/lib/__tests__/agent-runtime-v3.test.ts --maxWorkers=1",
    "test:agent:m3": "vitest run src/lib/__tests__/agent-m3-contract.test.ts src/lib/__tests__/agent-runtime-v3.test.ts src/components/ai/__tests__/agent-m3-context-surface.test.tsx --maxWorkers=1",
    "test:agent:m4": "vitest run src/lib/__tests__/agent-runtime-v3.test.ts src/lib/__tests__/agent-m4-contract.test.ts src/components/ai/__tests__/agent-m4-task-center.test.tsx --maxWorkers=1",
    "test:agent:m5": "vitest run src/lib/__tests__/agent-m5-contract.test.ts src/components/ai/__tests__/agent-m5-fleet-center.test.tsx --maxWorkers=1",
    "baseline:agent:v2": "node scripts/collect-agent-v2-baseline.mjs --write",
    "test:agent:platform": "vitest run src/lib/__tests__/agent-platform-acceptance.test.ts && cargo test --manifest-path src-tauri/Cargo.toml --locked real_",
    "test:agent:providers:live": "node scripts/run-agent-provider-acceptance.mjs",
    "test:agent:providers:minimax:live": "node scripts/run-agent-provider-acceptance.mjs --minimax-only",
    "check:agent-terminal": "pnpm test:agent:security",
    "petdex:phase3": "node scripts/petdex-phase3-gate.mjs",
    "petdex:phase3:gate": "node scripts/petdex-phase3-gate.mjs --require-pass",
    "petdex:phase4:audit": "node scripts/petdex-phase4-admission-gate.mjs",
    "petdex:phase4:gate": "node scripts/petdex-phase4-admission-gate.mjs --require-admitted",
    "benchmark:terminal": "vitest bench --run --config scripts/perf/vitest.config.ts",
    "benchmark:terminal:transport": "cargo run --release --manifest-path src-tauri/Cargo.toml --example terminal_transport_baseline --",
    "review:frontend": "pnpm test:scripts && pnpm test && pnpm build",
    "test:e2e:ssh": "node scripts/run-ssh-e2e.mjs",
    "test:e2e:ssh:agent-m2": "node scripts/run-ssh-e2e.mjs --agent-m2",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "version": "node scripts/bump-version.mjs",
    "changelog": "git-cliff -o CHANGELOG.md"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@shadcn/react": "^0.3.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.27.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-intl-universal": "^2.14.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "ajv": "^8.20.0",
    "code-inspector-plugin": "^1.6.6",
    "git-cliff": "^2.13.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.1"
}
