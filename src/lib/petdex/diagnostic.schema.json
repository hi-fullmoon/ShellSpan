{
  "$id": "petdex",
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "status", "errorReason", "targetAction", "lastSuccessAt"],
      "properties": {
        "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "status": { "enum": ["disabled", "checking", "notDetected", "connected", "unreachable", "unauthorized", "rejected", "tokenUnreadable", "tokenInvalid", "connectionError"] },
        "errorReason": { "enum": [null, "tokenMissing", "tokenUnreadable", "tokenInvalid", "transport", "unauthorized", "rejected"] },
        "targetAction": { "enum": [null, "idle", "waiting", "waving", "running", "jumping", "failed"] },
        "lastSuccessAt": { "type": ["integer", "null"], "minimum": 0, "maximum": 8640000000000000 }
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnostic", "health"],
      "properties": {
        "diagnostic": { "$ref": "#/$defs/diagnostic" },
        "health": { "enum": ["reachable", "unavailable", "disabled"] }
      }
    },
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnostic", "preview"],
      "properties": {
        "diagnostic": { "$ref": "#/$defs/diagnostic" },
        "preview": { "enum": ["requested", "overridden", "failed", "disabled"] }
      }
    }
  }
}
