+// Application-private layout enabled only by the verified host provider. No source-buffer or authority mutation.
+using System;
+using System.Collections.Generic;
+using System.Text;
+namespace Microsoft.PowerShell {
+ internal static class ShellSpanLayout {
+  internal static bool Enabled;
+  internal sealed class Unit {internal int Start,End,Width;internal bool Newline;}
+  internal static List<Unit> Units(string text,bool sgr=true){
+   var result=new List<Unit>();int preceding=0;
+   for(int index=0;index<text.Length;){int start=index;char first=text[index];
+    if(sgr&&first==0x1b&&index+1<text.Length&&text[index+1]=='['){index+=2;while(index<text.Length&&text[index]!='m')index++;if(index<text.Length)index++;continue;}
+    if(first=='\n'||char.IsControl(first)){result.Add(new Unit{Start=start,End=++index,Width=first=='\n'?0:2,Newline=first=='\n'});preceding=0;continue;}
+    int cp=first;index++;if(char.IsHighSurrogate(first)&&index<text.Length&&char.IsLowSurrogate(text[index])){cp=char.ConvertToUtf32(first,text[index]);index++;}
+    int properties=ShellSpanGraphemeData.Properties(cp,preceding),width=(properties>>1)&3;
+    if((properties&1)!=0&&result.Count>0&&!result[result.Count-1].Newline){var unit=result[result.Count-1];unit.End=index;unit.Width=width;}
+    else result.Add(new Unit{Start=start,End=index,Width=width});preceding=properties;
+   }return result;
+  }
+  internal static string PromptSuffix(string prompt){var visible=new StringBuilder();for(int index=0;index<prompt.Length;index++){if(prompt[index]==0x1b&&index+1<prompt.Length&&prompt[index+1]=='['){index+=2;while(index<prompt.Length&&prompt[index]!='m')index++;continue;}visible.Append(prompt[index]);}string text=visible.ToString();var units=Units(text,false);for(int index=units.Count-1;index>=0;index--)if(!char.IsWhiteSpace(text[units[index].Start]))return text.Substring(units[index].Start);return null;}
+  internal static int Measure(string text,int start,int end){int cells=0;foreach(var unit in Units(text))if(unit.Start>=start&&unit.Start<end)cells+=unit.Width;return cells;}
+  internal static int Slice(string text,int start,int cells){int width=0,end=start;foreach(var unit in Units(text,false)){if(unit.Start<start)continue;if(width+unit.Width>cells)break;width+=unit.Width;end=unit.End;}return end-start;}
+  internal static int SliceFromEnd(string text,int start,int cells){int width=0,end=start+1,begin=end;var units=Units(text,false);for(int i=units.Count-1;i>=0;i--){var unit=units[i];if(unit.End>end)continue;if(width+unit.Width>cells)break;width+=unit.Width;begin=unit.Start;}return end-begin;}
+  internal static int Physical(string text,int width,int initialX,out int last){int x=initialX,y=1;last=0;foreach(var unit in Units(text)){if(unit.Newline){y++;x=0;last=0;continue;}if(x==0&&last>0){y++;last=0;}x+=unit.Width;last+=unit.Width;if(x==width)x=0;else if(x>width){x=unit.Width;y++;last=unit.Width;}}return y;}
+  static void Advance(Unit unit,ref int x,ref int y,int width,int continuation,bool nextNewline){if(unit.Newline){y++;x=continuation;return;}x+=unit.Width;if(x>=width){x=x==width?0:unit.Width;if(x!=0||!nextNewline)y++;}}
+  internal static Point Offset(string text,int offset,int initialX,int initialY,int width,int continuation){int x=initialX,y=initialY;var units=Units(text,false);for(int i=0;i<units.Count;i++){var unit=units[i];if(unit.Start>=offset)break;Advance(unit,ref x,ref y,width,continuation,i+1<units.Count&&units[i+1].Start<offset&&units[i+1].Newline);}foreach(var unit in units)if(unit.Start==offset&&!unit.Newline&&x+unit.Width>width){x=0;y++;break;}return new Point{X=x,Y=y};}
+  internal static int ToOffset(string text,Point point,int initialX,int initialY,int width,int continuation){int x=initialX,y=initialY;var units=Units(text,false);for(int i=0;i<units.Count;i++){var unit=units[i];if(point.Y==y&&point.X<=x)return unit.Start;if(unit.Newline&&point.Y==y)return unit.Start;if(!unit.Newline&&x+unit.Width>width){x=0;y++;}if(!unit.Newline&&point.Y==y&&point.X<x+unit.Width)return unit.Start;Advance(unit,ref x,ref y,width,continuation,i+1<units.Count&&units[i+1].Newline);if(point.Y<y)return unit.Start;}return point.Y==y?text.Length:-1;}
+  internal sealed class LinePoints {internal List<Point> Starts=new List<Point>();internal Point End;}
+  static List<LinePoints> Lines(int initialX,int initialY,int width,RenderData data){int x=initialX,y=initialY;var lines=new List<LinePoints>();foreach(var line in data.lines){var points=new LinePoints();var units=Units(line.Line);foreach(var unit in units){if(unit.Newline){points.Starts.Add(new Point{X=x,Y=y});y++;x=0;continue;}if(x+unit.Width>width){x=0;y++;}points.Starts.Add(new Point{X=x,Y=y});x+=unit.Width;if(x==width){x=0;y++;}}points.End=new Point{X=x,Y=y};lines.Add(points);if(x>0||units.Count==0){x=0;y++;}}return lines;}
+  internal static Point RenderPoint(int initialX,int initialY,int width,RenderData data,RenderDataOffset offset){if(offset.LogicalLineIndex==0&&offset.VisibleCharIndex==-1)return new Point{X=initialX,Y=initialY};var line=Lines(initialX,initialY,width,data)[offset.LogicalLineIndex];return offset.VisibleCharIndex==int.MaxValue||offset.VisibleCharIndex>=line.Starts.Count?line.End:line.Starts[offset.VisibleCharIndex];}
