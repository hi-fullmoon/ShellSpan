+   if(observation.Item2){
+    if(x!=columns-1||Column(columns)!=0||widths.Length==0){widths=null;throw new InvalidOperationException("Invalid pending-wrap observation");}
+    // Materialize the terminal's already pending soft wrap, without inserting
+    // into the editor buffer or evaluating/returning source. Backspace leaves
+    // the next input origin at column zero, including a real bottom-row scroll.
+    console.Write(" \b");x=console.CursorLeft;y=console.CursorTop;
+    if(x!=0){widths=null;throw new InvalidOperationException("Pending wrap did not settle");}
+   }else if(Column(columns)!=x){widths=null;throw new InvalidOperationException("Display observation does not reproduce the actual cursor");}
+  }
