+using System;
+using System.Threading;
+namespace Microsoft.PowerShell {
+ internal static class ShellSpanEditorLifecycle {
+  static Action initialized;
+  static int editorThread;
+  internal static void Configure(Action observer){
+   if(observer==null)throw new ArgumentNullException(nameof(observer));
+   if(initialized!=null)throw new InvalidOperationException("Editor lifecycle already configured");
+   editorThread=Thread.CurrentThread.ManagedThreadId;initialized=observer;
+  }
+  internal static void ReadLineInitialized(){
+   if(initialized==null)return;
+   if(Thread.CurrentThread.ManagedThreadId!=editorThread)throw new InvalidOperationException("Editor lifecycle thread changed");
