+using System;
+using System.Threading;
+namespace Microsoft.PowerShell {
+ internal static class ShellSpanPromptOrigin {
+  static Func<int,int,int,int,Tuple<int[],bool>> provider;
+  static int editorThread;
+  static int[] widths;
+  internal static void ConfigureProvider(Func<int,int,int,int,Tuple<int[],bool>> observe){
+   if(observe==null)throw new ArgumentNullException(nameof(observe));
+   if(provider!=null)throw new InvalidOperationException("Display provider already configured");
+   editorThread=Thread.CurrentThread.ManagedThreadId;
+   provider=observe;ShellSpanLayout.Enabled=true;
+  }
+  internal static void Begin(ref int x,ref int y,Microsoft.PowerShell.Internal.IConsole console){
+   widths=null;if(!ShellSpanLayout.Enabled||provider==null)return;
+   if(Thread.CurrentThread.ManagedThreadId!=editorThread)throw new InvalidOperationException("Display editor thread changed");
+   int columns=console.BufferWidth,rows=console.BufferHeight;
+   var observation=provider(columns,rows,x,y);
+   int[] observed=observation==null?null:observation.Item1;
+   if(observed==null||observed.Length>65536)throw new InvalidOperationException("Display observation unavailable");
+   int[] copy=new int[observed.Length];for(int i=0;i<copy.Length;i++){if(observed[i]!=1&&observed[i]!=2)throw new InvalidOperationException("Display width rejected");copy[i]=observed[i];}
